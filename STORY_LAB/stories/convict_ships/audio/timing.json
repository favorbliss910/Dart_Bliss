{
 "voice": "kokoro/am_michael",
 "duration": 62.09,
 "speech_end": 60.49,
 "chunks": [
  {
   "i": 0,
   "mood": "hook",
   "text": "One in four people died on these ships. Then the government changed one line in a contract... and almost all of them lived.",
   "s": 0.25,
   "e": 7.739
  },
  {
   "i": 1,
   "mood": "normal",
   "text": "In seventeen ninety, Britain was shipping prisoners to Australia. Eight months across the ocean.",
   "s": 8.139,
   "e": 13.653
  },
  {
   "i": 2,
   "mood": "normal",
   "text": "The captains were paid for every prisoner who walked onto the ship.",
   "s": 13.873,
   "e": 17.05
  },
  {
   "i": 3,
   "mood": "turn",
   "text": "So the captains did the math. A prisoner who eats less costs less. A prisoner who dies... costs nothing.",
   "s": 17.27,
   "e": 23.706
  },
  {
   "i": 4,
   "mood": "dread",
   "text": "They packed them below deck. In chains. In the dark. And sold their food at every port.",
   "s": 23.926,
   "e": 29.152
  },
  {
   "i": 5,
   "mood": "dread",
   "text": "On one fleet, more than one in four never made it.",
   "s": 29.372,
   "e": 32.124
  },
  {
   "i": 6,
   "mood": "normal",
   "text": "People were horrified. Captains were told to be kind. Nothing changed.",
   "s": 32.344,
   "e": 36.256
  },
  {
   "i": 7,
   "mood": "turn",
   "text": "Then someone changed one line. Captains wouldn't be paid for every prisoner who got on the ship. They'd be paid for every prisoner who got off it. Alive.",
   "s": 36.656,
   "e": 46.007
  },
  {
   "i": 8,
   "mood": "normal",
   "text": "Suddenly, captains hired doctors. Bought fresh food. Let the prisoners up into the sunlight.",
   "s": 46.227,
   "e": 51.494
  },
  {
   "i": 9,
   "mood": "normal",
   "text": "And almost every prisoner arrived alive.",
   "s": 51.714,
   "e": 53.811
  },
  {
   "i": 10,
   "mood": "final",
   "text": "Same ships. Same captains. Same ocean. The only thing that changed... was what they got paid for.",
   "s": 54.031,
   "e": 60.49
  }
 ],
